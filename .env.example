# Gemini API Key (Required)
# You can obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Alternatively, GOOGLE_API_KEY is also supported:
# GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Optional, defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Model Temperature (Optional, default 0.0 for accurate tool use and reasoning)
TEMPERATURE=0.0
